rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function text(value, max) { return value is string && value.size() <= max; }
    function appointment(uid, id) { return /databases/$(database)/documents/patients/$(uid)/appointments/$(id); }
    function slotPath(id) { return /databases/$(database)/documents/slots/$(id); }
    function validProfile(d) {
      return d.keys().hasAll(['name', 'phone', 'birthDate', 'city'])
        && d.keys().hasOnly(['name', 'phone', 'birthDate', 'city'])
        && text(d.name, 100) && d.name.size() >= 3
        && text(d.phone, 22) && text(d.birthDate, 10) && text(d.city, 100);
    }
    function validExam(d, id) {
      return d.keys().hasAll(['id', 'name', 'laboratory', 'date', 'status', 'notes', 'createdAt'])
        && d.keys().hasOnly(['id', 'name', 'laboratory', 'date', 'status', 'notes', 'createdAt'])
        && d.id == id && text(d.name, 120) && d.name.size() > 0
        && text(d.laboratory, 160) && text(d.date, 10) && text(d.notes, 1000)
        && d.status in ['requested', 'scheduled', 'completed'] && text(d.createdAt, 40);
    }
    function validBooking(uid, id, d) {
      let slot = get(slotPath(d.slotId)).data;
      let after = getAfter(slotPath(d.slotId)).data;
      return d.keys().hasAll(['id', 'slotId', 'specialty', 'professional', 'unit', 'address', 'date', 'time', 'status', 'createdAt'])
        && d.keys().hasOnly(['id', 'slotId', 'specialty', 'professional', 'unit', 'address', 'date', 'time', 'status', 'createdAt'])
        && d.id == id && text(d.createdAt, 40) && d.status == 'confirmed'
        && id == slot.date + '_' + slot.time.split(':')[0] + '-' + slot.time.split(':')[1]
        && slot.available == true && slot.startsAt > request.time
        && d.specialty == slot.specialty && d.professional == slot.professional
        && d.unit == slot.unit && d.address == slot.address && d.date == slot.date && d.time == slot.time
        && after.available == false && after.patientId == uid && after.appointmentId == id;
    }
    match /patients/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validProfile(request.resource.data);
      match /exams/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validExam(request.resource.data, id);
      }
      match /notices/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasAll(['id', 'title', 'body', 'read', 'createdAt'])
          && request.resource.data.keys().hasOnly(['id', 'title', 'body', 'read', 'createdAt'])
          && request.resource.data.id == id && request.resource.data.read == false
          && text(request.resource.data.title, 140) && text(request.resource.data.body, 500)
          && text(request.resource.data.createdAt, 40);
        allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }
      match /appointments/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validBooking(uid, id, request.resource.data);
        allow update: if owner(uid) && (
          (resource.data.status == 'cancelled' && validBooking(uid, id, request.resource.data))
          || (resource.data.status == 'confirmed' && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && get(slotPath(resource.data.slotId)).data.patientId == uid
            && getAfter(slotPath(resource.data.slotId)).data.available == true
            && getAfter(slotPath(resource.data.slotId)).data.patientId == null)
        );
      }
    }
    // Only the institution (Admin SDK / console) creates, edits or removes slots.
    // Reserved slots are readable only by their owner, not by other patients.
    match /slots/{slotId} {
      allow read: if signedIn() && (resource.data.available == true || resource.data.patientId == request.auth.uid);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available', 'patientId', 'appointmentId'])
        && (
          (resource.data.available == true && request.resource.data.available == false
            && resource.data.startsAt > request.time
            && request.resource.data.patientId == request.auth.uid
            && getAfter(appointment(request.auth.uid, request.resource.data.appointmentId)).data.status == 'confirmed'
            && getAfter(appointment(request.auth.uid, request.resource.data.appointmentId)).data.slotId == slotId
            && (!exists(appointment(request.auth.uid, request.resource.data.appointmentId))
              || get(appointment(request.auth.uid, request.resource.data.appointmentId)).data.status == 'cancelled'))
          || (resource.data.available == false && resource.data.patientId == request.auth.uid
            && request.resource.data.available == true && request.resource.data.patientId == null
            && request.resource.data.appointmentId == null
            && get(appointment(request.auth.uid, resource.data.appointmentId)).data.status == 'confirmed'
            && getAfter(appointment(request.auth.uid, resource.data.appointmentId)).data.status == 'cancelled')
        );
    }
  }
}
